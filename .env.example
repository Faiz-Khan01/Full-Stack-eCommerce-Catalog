# ==========================================
# TechStore Backend Environment Variables
# ==========================================

# 1. Server Configuration
PORT=8082
FRONTEND_URL=http://localhost:5173

# 2. MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/product_catalog?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# 3. Security & JWT Configuration
# Note: JWT_SECRET must be at least 32 characters long
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_12345
JWT_EXPIRATION_MS=86400000

# 4. Google OAuth2 Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 5. GitHub OAuth2 Configuration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# 6. Gmail SMTP Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_specific_password
ADMIN_EMAIL=your_admin_email@example.com

# 7. Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
